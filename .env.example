# ──────────────────────────────────────────────
# RAGFlow 知识库服务
# ──────────────────────────────────────────────
RAGFLOW_API_URL=http://your-ragflow-server:port
RAGFLOW_API_KEY=ragflow-your-api-key

# ──────────────────────────────────────────────
# LLM 配置（DashScope / 通义千问）
# 1. https://bailian.console.aliyun.com/cn-beijing?tab=model#/api-key
# 2. https://bailian.console.aliyun.com/cn-beijing?tab=costing-balance#/costing-balance/free-quota
# ──────────────────────────────────────────────
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-dashscope-api-key
LLM_QWEN2.5=qwen2.5-14b-instruct
LLM_QWEN3=qwen3-32b
LLM_QWEN_MAX=qwen-max

# ──────────────────────────────────────────────
# Tavily 网络搜索 API
# ──────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-tavily-api-key

# ──────────────────────────────────────────────
# MySQL 数据库配置
# ──────────────────────────────────────────────
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=pharma_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
